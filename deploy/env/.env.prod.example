# .env.prod 模板 —— 复制成 VPS 上 /data/medusa/.env.prod 后填真实值
# 这个文件本身不含任何真实密钥，可以提交；.env.prod 本体绝不能提交（见 .gitignore）
# 注意：DATABASE_URL 和 REDIS_URL 不在这里，在 docker-compose.prod.yml 里

# --- 密钥：三个都要用 openssl rand -hex 32 各生成一个，互不相同 ---
POSTGRES_PASSWORD=<CHANGE_ME>
JWT_SECRET=<CHANGE_ME>
COOKIE_SECRET=<CHANGE_ME>

# --- CORS：必须是生产域名，不能留 localhost ---
STORE_CORS=https://shop.satank.cn
ADMIN_CORS=https://shop-admin.satank.cn
AUTH_CORS=https://shop.satank.cn,https://shop-admin.satank.cn

# --- 商城构建时 baked 进去的公开值 ---
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY 必须是数据库里那把真 key（pk_ 开头）：
# 建好后端、数据库里有 Default Publishable API Key 后，从数据库取，
# 或在 Admin 里 Settings > Publishable API Key 查看。改了它必须重建商城。
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://shop-admin.satank.cn
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_<CHANGE_ME>
NEXT_PUBLIC_BASE_URL=https://shop.satank.cn
NEXT_PUBLIC_DEFAULT_REGION=us

# --- 域名和端口 ---
STORE_DOMAIN=shop.satank.cn
API_DOMAIN=shop-admin.satank.cn
HTTP_PORT=80
HTTPS_PORT=443
