# dtc-runtime 基础镜像（Medusa 2.22.6 版）
# 用法（在 VPS 上，构建上下文为本目录）：
#   docker build -f Dockerfile.dtc-runtime-2.22.6 -t dtc-runtime:node22-pnpm10-2.22.6 .
# 来源：fork charlock/dtc-starter main 6440e85（Medusa 2.22.6 / Next 16.3.8）
# 原镜像 dtc-runtime:node22-pnpm10（2.21.2）的 Dockerfile 是从 `docker history` 还原的：
#   node:22.23.3-alpine + rsync + corepack pnpm 10.11.1，WORKDIR /app，
#   只复制 package 清单 + medusa-config.ts + next.config.js，然后 pnpm install --frozen-lockfile。
# 镜像里只有 node_modules（运行时依赖），没有仓库源码；后端代码由发布包挂载进容器。
FROM node:22.23.3-alpine

RUN apk add --no-cache rsync && corepack enable && corepack prepare pnpm@10.11.1 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/storefront/package.json ./apps/storefront/
COPY apps/backend/medusa-config.ts ./apps/backend/
COPY apps/storefront/next.config.js ./apps/storefront/

RUN pnpm install --frozen-lockfile
